{
  "name": "web-codex",
  "version": "0.1.2",
  "description": "A Codex-grade local MCP workspace for ChatGPT",
  "type": "module",
  "main": "./out/main/index.js",
  "author": "dixtdf",
  "license": "Apache-2.0",
  "scripts": {
    "predev": "npm run tunnel:prepare",
    "dev": "electron-vite dev",
    "icons": "node scripts/generate-icons.mjs",
    "tunnel:prepare": "node scripts/prepare-tunnel-client.mjs",
    "prebuild": "npm run icons && npm run tunnel:prepare",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "dist": "npm run build && electron-builder",
    "dist:win": "npm run build && electron-builder --win",
    "dist:mac": "npm run build && electron-builder --mac",
    "dist:linux": "npm run build && electron-builder --linux",
    "lint": "eslint src tests scripts electron.vite.config.ts vitest.config.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "vitest run tests/e2e",
    "test:tunnel": "vite-node scripts/verify-official-tunnel.ts",
    "test:ui": "node scripts/ui-smoke.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.17.0",
    "express": "^5.1.0",
    "lucide-react": "^0.468.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "undici": "^7.13.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@electron/fuses": "^2.1.3",
    "@types/adm-zip": "^0.5.8",
    "@types/express": "^5.0.3",
    "@types/node": "^24.3.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^5.0.0",
    "@vitest/coverage-v8": "^5.0.5",
    "adm-zip": "^0.6.1",
    "electron": "^45.2.1",
    "electron-builder": "^26.0.12",
    "electron-vite": "^4.0.0",
    "eslint": "^9.34.0",
    "png2icons": "^2.0.1",
    "sharp": "^0.35.5",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.41.0",
    "vite": "^7.1.0",
    "vite-node": "^6.0.0",
    "vitest": "^5.0.5"
  },
  "engines": {
    "node": ">=22.16.0"
  }
}
